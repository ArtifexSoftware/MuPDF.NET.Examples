<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Packed Artifex packages (MuPDF.NET, Fonts, NativeAssets, Office). -->
    <add key="LocalArtifex" value="D:\Artifex\LocalNuget" />
    <!-- Optional drop folder in this repo (symlink or copy). -->
    <add key="LocalNuget" value="LocalNuget" />
    <!-- Transitive deps and packages not present locally (e.g. Office.NativeAssets). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
