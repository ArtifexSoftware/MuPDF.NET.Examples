<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Package sources for MuPDF.NET.Examples (Windows + Linux).
    LocalArtifex is a repo-local folder (create/symlink packages into ./LocalNuget).
    nuget.org remains available for published packages.
  -->
  <packageSources>
    <clear />
    <add key="LocalArtifex" value="LocalNuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
