<Project>
  <!--
    Single source of truth for NuGet package versions in MuPDF.NET.Examples.
    See NuGet.Config for restore sources (repo-local LocalNuget/, then nuget.org).
  -->
  <PropertyGroup Label="Artifex package versions">
    <ArtifexMuPDFNetVersion>4.1.0</ArtifexMuPDFNetVersion>
    <ArtifexMuPDFNetOfficeVersion>2.1.0</ArtifexMuPDFNetOfficeVersion>
  </PropertyGroup>
</Project>
