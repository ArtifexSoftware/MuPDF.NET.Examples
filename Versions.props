<Project>
  <!--
    Single source of truth for NuGet package versions in MuPDF.NET.Examples.
    Prefer packages from D:\Artifex\LocalNuget when present (see NuGet.Config).
  -->
  <PropertyGroup Label="Artifex package versions">
    <ArtifexMuPDFNetVersion>4.0.0</ArtifexMuPDFNetVersion>
    <ArtifexMuPDFNetOfficeVersion>2.0.2</ArtifexMuPDFNetOfficeVersion>
  </PropertyGroup>
</Project>
