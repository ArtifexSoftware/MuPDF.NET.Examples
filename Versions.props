<Project>
  <!--
    Single source of truth for NuGet package versions in MuPDF.NET.Examples.
    Prefer packages from D:\Artifex\LocalNuget when present (see NuGet.Config).
  -->
  <PropertyGroup Label="Artifex package versions">
    <ArtifexMuPDFNetVersion>3.28.2</ArtifexMuPDFNetVersion>
    <ArtifexMuPDFNetPDF4LLMVersion>1.28.2</ArtifexMuPDFNetPDF4LLMVersion>
    <ArtifexMuPDFNetOfficeVersion>1.28.2</ArtifexMuPDFNetOfficeVersion>
  </PropertyGroup>
</Project>
